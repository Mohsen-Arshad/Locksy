<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<OutputType>Exe</OutputType>
		<RootNamespace>Locksy</RootNamespace>
		<AssemblyName>Locksy</AssemblyName>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>Locksy</ApplicationTitle>
		<ApplicationId>com.mohsen.locksy</ApplicationId>
		<ApplicationDisplayVersion>1.3.8</ApplicationDisplayVersion>
		<ApplicationVersion>33</ApplicationVersion>

		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		<TargetSdkVersion>35</TargetSdkVersion>
		<AndroidUseLatestPlatformSdk>true</AndroidUseLatestPlatformSdk>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls"
						  Version="10.0.110" />

		<PackageReference Include="Microsoft.Maui.Resizetizer"
						  Version="10.0.100"
						  PrivateAssets="all"
						  NoWarn="NU1605" />
	</ItemGroup>

	<!-- Ensure SplashPage XAML is passed through MAUI XAML code generation. -->
	<ItemGroup>
		<MauiXaml Remove="SplashPage.xaml" />
		<MauiXaml Include="SplashPage.xaml"
				   Generator="MSBuild:Compile" />
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources/AppIcon/appicon.png"
				  Color="#070910"
				  BaseSize="128,128" />

		<MauiSplashScreen Include="Resources/Splash/splash.png"
						  Color="#20212D"
						  BaseSize="112,112" />

		<MauiImage Include="Resources/Images/*" />

		<MauiAsset Include="Resources/Raw/**"
				   LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

</Project>
