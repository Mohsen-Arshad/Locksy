<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<OutputType>Exe</OutputType>
		<RootNamespace>Locksy</RootNamespace>
		<AssemblyName>Locksy</AssemblyName>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>Locksy</ApplicationTitle>
		<ApplicationId>com.homonar.locksy</ApplicationId>
		<ApplicationDisplayVersion>1.3.13</ApplicationDisplayVersion>
		<ApplicationVersion>38</ApplicationVersion>

		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		<TargetSdkVersion>35</TargetSdkVersion>
		<AndroidUseLatestPlatformSdk>true</AndroidUseLatestPlatformSdk>
		<AndroidSigningKeyStore></AndroidSigningKeyStore>
		<PackageIcon>appicon.svg</PackageIcon>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
	  <AndroidKeyStore>False</AndroidKeyStore>
	  <AndroidSigningStorePass></AndroidSigningStorePass>
	  <AndroidSigningKeyAlias></AndroidSigningKeyAlias>
	  <AndroidSigningKeyPass></AndroidSigningKeyPass>
	  <ApplicationId>com.homonar.locksy</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
	  <AndroidKeyStore>False</AndroidKeyStore>
	  <AndroidSigningStorePass></AndroidSigningStorePass>
	  <AndroidSigningKeyAlias></AndroidSigningKeyAlias>
	  <AndroidSigningKeyPass></AndroidSigningKeyPass>
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	  <ApplicationId>com.homonar.locksy</ApplicationId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />

		<PackageReference Include="Microsoft.Maui.Resizetizer" Version="10.0.110" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#070910" BaseSize="128,128" />

		<MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#20212D" BaseSize="128,128" />

		<MauiImage Include="Resources/Images/*" />

		<MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="Resources\AppIcon\appicon.svg">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
